{
  "description": "Benchmark cases from SPEC.md section 6. Expected values are reference results; do not edit them to make a test pass.",
  "level1": {
    "tolerance": "exact to 4 significant figures",
    "cases": [
      {
        "id": "A1",
        "check": "Simply supported beam: first frequency and modal mass",
        "source": "Analytical, SPEC.md 2.1",
        "inputs": { "L": 30, "m": 1000, "EI": 1.3131e9 },
        "expected": { "f1": 2.0, "M": 15000 }
      },
      {
        "id": "A2",
        "check": "Effective span and lambda for a half-sine mode",
        "source": "NA.2.44.4 Figure NA.7 and NA.2.44.5, SPEC.md 2.2",
        "inputs": { "L": 30, "shape": "half-sine" },
        "expected": { "Seff": 30.12, "lambda": 0.6366 }
      },
      {
        "id": "A3",
        "check": "Comfort limit within bounds",
        "source": "NA.2.44.6, SPEC.md 2.7; matches 1.46 m/s2 reported for the Aberfeldy footbridge, MDPI Materials 2023, 16, 2890",
        "inputs": { "k1": 1.6, "k2": 1.3, "k3": 0.7, "k4": 1.0 },
        "expected": { "raw": 1.456, "aLimit": 1.456 }
      },
      {
        "id": "A4",
        "check": "Comfort limit clamped to lower bound",
        "source": "NA.2.44.6, SPEC.md 2.7",
        "inputs": { "k1": 0.6, "k2": 0.7, "k3": 0.7 },
        "expected": { "raw": 0.294, "aLimit": 0.5 }
      },
      {
        "id": "A5",
        "check": "Comfort limit clamped to upper bound",
        "source": "NA.2.44.6, SPEC.md 2.7",
        "inputs": { "k1": 1.6, "k2": 1.3, "k3": 1.1, "k4": 1.2 },
        "expected": { "raw": 2.746, "aLimit": 2.0 }
      },
      {
        "id": "A6",
        "check": "Crowd density capped in the load",
        "source": "NA.2.44.5, SPEC.md 2.3",
        "inputs": { "rho": 1.5 },
        "expected": { "rhoUsed": 1.0 }
      }
    ]
  }
}
